<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:choreo="http://eda.com/choreography" id="charge-and-reward-then-ship-then-aftercare-two-forks-definitions" targetNamespace="http://eda.com/flows">
  <bpmn:process id="charge-and-reward-then-ship-then-aftercare-two-forks" isExecutable="true" choreo:joinTimeout="PT6S">
    <bpmn:documentation>Two forks one after the other, each joined by a real service. Both branches of the first fork run at the payment service.</bpmn:documentation>
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_reserve" name="reserve stock" choreo:service="inventory"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="fork1"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f4</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_charge" name="charge" choreo:service="payment"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_loyalty" name="give loyalty points" choreo:service="payment"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="join1"><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_book" name="book courier" choreo:service="shipping"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="fork2"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_loyalty_bonus" name="give bonus points" choreo:service="payment"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_spare" name="reserve spare" choreo:service="inventory"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="join2"><bpmn:incoming>f11</bpmn:incoming><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_confirm" name="confirm order" choreo:service="orders"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="Task_reserve" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_reserve" targetRef="fork1" />
    <bpmn:sequenceFlow id="f3" sourceRef="fork1" targetRef="Task_charge" />
    <bpmn:sequenceFlow id="f4" sourceRef="fork1" targetRef="Task_loyalty" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_charge" targetRef="join1" />
    <bpmn:sequenceFlow id="f6" sourceRef="Task_loyalty" targetRef="join1" />
    <bpmn:sequenceFlow id="f7" sourceRef="join1" targetRef="Task_book" />
    <bpmn:sequenceFlow id="f8" sourceRef="Task_book" targetRef="fork2" />
    <bpmn:sequenceFlow id="f9" sourceRef="fork2" targetRef="Task_loyalty_bonus" />
    <bpmn:sequenceFlow id="f10" sourceRef="fork2" targetRef="Task_spare" />
    <bpmn:sequenceFlow id="f11" sourceRef="Task_loyalty_bonus" targetRef="join2" />
    <bpmn:sequenceFlow id="f12" sourceRef="Task_spare" targetRef="join2" />
    <bpmn:sequenceFlow id="f13" sourceRef="join2" targetRef="Task_confirm" />
    <bpmn:sequenceFlow id="f14" sourceRef="Task_confirm" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="charge-and-reward-then-ship-then-aftercare-two-forks-diagram">
    <bpmndi:BPMNPlane id="charge-and-reward-then-ship-then-aftercare-two-forks-plane" bpmnElement="charge-and-reward-then-ship-then-aftercare-two-forks">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="60" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_reserve_di" bpmnElement="Task_reserve"><dc:Bounds x="130" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork1_di" bpmnElement="fork1"><dc:Bounds x="280" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_charge_di" bpmnElement="Task_charge"><dc:Bounds x="380" y="70" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_loyalty_di" bpmnElement="Task_loyalty"><dc:Bounds x="380" y="290" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join1_di" bpmnElement="join1"><dc:Bounds x="530" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_book_di" bpmnElement="Task_book"><dc:Bounds x="620" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork2_di" bpmnElement="fork2"><dc:Bounds x="770" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_loyalty_bonus_di" bpmnElement="Task_loyalty_bonus"><dc:Bounds x="870" y="70" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_spare_di" bpmnElement="Task_spare"><dc:Bounds x="870" y="290" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join2_di" bpmnElement="join2"><dc:Bounds x="1020" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_confirm_di" bpmnElement="Task_confirm"><dc:Bounds x="1110" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1260" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="96" y="220" /><di:waypoint x="130" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="230" y="220" /><di:waypoint x="280" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="305" y="195" /><di:waypoint x="305" y="110" /><di:waypoint x="380" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="305" y="245" /><di:waypoint x="305" y="330" /><di:waypoint x="380" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="480" y="110" /><di:waypoint x="555" y="110" /><di:waypoint x="555" y="195" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="480" y="330" /><di:waypoint x="555" y="330" /><di:waypoint x="555" y="245" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="580" y="220" /><di:waypoint x="620" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="720" y="220" /><di:waypoint x="770" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="795" y="195" /><di:waypoint x="795" y="110" /><di:waypoint x="870" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="795" y="245" /><di:waypoint x="795" y="330" /><di:waypoint x="870" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="970" y="110" /><di:waypoint x="1045" y="110" /><di:waypoint x="1045" y="195" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="970" y="330" /><di:waypoint x="1045" y="330" /><di:waypoint x="1045" y="245" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1070" y="220" /><di:waypoint x="1110" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1210" y="220" /><di:waypoint x="1260" y="220" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
