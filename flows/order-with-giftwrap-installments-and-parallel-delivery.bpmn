<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:choreo="http://eda.com/choreography" id="order-with-giftwrap-installments-and-parallel-delivery-definitions" targetNamespace="http://eda.com/flows">
  <bpmn:process id="order-with-giftwrap-installments-and-parallel-delivery" isExecutable="true" choreo:joinTimeout="PT6S" choreo:maxIterations="5">
    <bpmn:documentation>Everything in one flow: a choice, a late-bound service behind it, a loop with a limit, a fork with a choice inside a branch, a join with a timeout, services that run several steps, and a step after the join.</bpmn:documentation>
    <bpmn:startEvent id="start"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_reserve" name="reserve stock" choreo:service="inventory"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gift" name="400 or more?" default="f4"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:outgoing>f4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_wrap" name="wrap as gift" choreo:service="giftwrap"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="again"><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_charge" name="charge installment" choreo:service="payment"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="paid" name="paid off?" default="f9"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_loyalty" name="give loyalty points" choreo:service="payment"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="fork"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_book" name="book courier" choreo:service="shipping"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="far" name="Graz?" default="f14"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_second_leg" name="book second courier" choreo:service="shipping"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="booked"><bpmn:incoming>f14</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_spare" name="reserve spare" choreo:service="inventory"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_loyalty_spare" name="points for spare" choreo:service="payment"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="join"><bpmn:incoming>f16</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_confirm" name="confirm order" choreo:service="orders"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_loyalty_bonus" name="give bonus points" choreo:service="payment"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end"><bpmn:incoming>f22</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="Task_reserve" />
    <bpmn:sequenceFlow id="f2" sourceRef="Task_reserve" targetRef="gift" />
    <bpmn:sequenceFlow id="f3" name="400 or more" sourceRef="gift" targetRef="Task_wrap"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['total'] &gt;= 400</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="gift" targetRef="again" />
    <bpmn:sequenceFlow id="f5" sourceRef="Task_wrap" targetRef="again" />
    <bpmn:sequenceFlow id="f6" sourceRef="again" targetRef="Task_charge" />
    <bpmn:sequenceFlow id="f7" sourceRef="Task_charge" targetRef="paid" />
    <bpmn:sequenceFlow id="f8" name="nothing remains" sourceRef="paid" targetRef="Task_loyalty"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['remaining'] &lt;= 0</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f9" name="next installment" sourceRef="paid" targetRef="again" />
    <bpmn:sequenceFlow id="f10" sourceRef="Task_loyalty" targetRef="fork" />
    <bpmn:sequenceFlow id="f11" sourceRef="fork" targetRef="Task_book" />
    <bpmn:sequenceFlow id="f12" sourceRef="Task_book" targetRef="far" />
    <bpmn:sequenceFlow id="f13" name="Graz" sourceRef="far" targetRef="Task_second_leg"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#result['city'] == 'Graz'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f14" sourceRef="far" targetRef="booked" />
    <bpmn:sequenceFlow id="f15" sourceRef="Task_second_leg" targetRef="booked" />
    <bpmn:sequenceFlow id="f16" sourceRef="booked" targetRef="join" />
    <bpmn:sequenceFlow id="f17" sourceRef="fork" targetRef="Task_spare" />
    <bpmn:sequenceFlow id="f18" sourceRef="Task_spare" targetRef="Task_loyalty_spare" />
    <bpmn:sequenceFlow id="f19" sourceRef="Task_loyalty_spare" targetRef="join" />
    <bpmn:sequenceFlow id="f20" sourceRef="join" targetRef="Task_confirm" />
    <bpmn:sequenceFlow id="f21" sourceRef="Task_confirm" targetRef="Task_loyalty_bonus" />
    <bpmn:sequenceFlow id="f22" sourceRef="Task_loyalty_bonus" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="order-with-giftwrap-installments-and-parallel-delivery-diagram">
    <bpmndi:BPMNPlane id="order-with-giftwrap-installments-and-parallel-delivery-plane" bpmnElement="order-with-giftwrap-installments-and-parallel-delivery">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="60" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_reserve_di" bpmnElement="Task_reserve"><dc:Bounds x="130" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gift_di" bpmnElement="gift"><dc:Bounds x="270" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_wrap_di" bpmnElement="Task_wrap"><dc:Bounds x="350" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="again_di" bpmnElement="again"><dc:Bounds x="490" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_charge_di" bpmnElement="Task_charge"><dc:Bounds x="570" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="paid_di" bpmnElement="paid"><dc:Bounds x="710" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_loyalty_di" bpmnElement="Task_loyalty"><dc:Bounds x="800" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fork_di" bpmnElement="fork"><dc:Bounds x="940" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_book_di" bpmnElement="Task_book"><dc:Bounds x="1030" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="far_di" bpmnElement="far"><dc:Bounds x="1170" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_second_leg_di" bpmnElement="Task_second_leg"><dc:Bounds x="1260" y="-10" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="booked_di" bpmnElement="booked"><dc:Bounds x="1400" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_spare_di" bpmnElement="Task_spare"><dc:Bounds x="1030" y="280" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_loyalty_spare_di" bpmnElement="Task_loyalty_spare"><dc:Bounds x="1220" y="280" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join"><dc:Bounds x="1490" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_confirm_di" bpmnElement="Task_confirm"><dc:Bounds x="1570" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_loyalty_bonus_di" bpmnElement="Task_loyalty_bonus"><dc:Bounds x="1720" y="180" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1870" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="96" y="220" /><di:waypoint x="130" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="230" y="220" /><di:waypoint x="270" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="295" y="195" /><di:waypoint x="295" y="100" /><di:waypoint x="350" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="320" y="220" /><di:waypoint x="490" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="450" y="100" /><di:waypoint x="515" y="100" /><di:waypoint x="515" y="195" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="540" y="220" /><di:waypoint x="570" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="670" y="220" /><di:waypoint x="710" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="760" y="220" /><di:waypoint x="800" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="735" y="245" /><di:waypoint x="735" y="330" /><di:waypoint x="515" y="330" /><di:waypoint x="515" y="245" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="900" y="220" /><di:waypoint x="940" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="965" y="195" /><di:waypoint x="965" y="120" /><di:waypoint x="1030" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="1130" y="120" /><di:waypoint x="1170" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1195" y="95" /><di:waypoint x="1195" y="30" /><di:waypoint x="1260" y="30" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><di:waypoint x="1220" y="120" /><di:waypoint x="1400" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><di:waypoint x="1360" y="30" /><di:waypoint x="1425" y="30" /><di:waypoint x="1425" y="95" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_di" bpmnElement="f16"><di:waypoint x="1425" y="145" /><di:waypoint x="1425" y="220" /><di:waypoint x="1490" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f17_di" bpmnElement="f17"><di:waypoint x="965" y="245" /><di:waypoint x="965" y="320" /><di:waypoint x="1030" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f18_di" bpmnElement="f18"><di:waypoint x="1130" y="320" /><di:waypoint x="1220" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f19_di" bpmnElement="f19"><di:waypoint x="1320" y="320" /><di:waypoint x="1515" y="320" /><di:waypoint x="1515" y="245" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f20_di" bpmnElement="f20"><di:waypoint x="1540" y="220" /><di:waypoint x="1570" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f21_di" bpmnElement="f21"><di:waypoint x="1670" y="220" /><di:waypoint x="1720" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f22_di" bpmnElement="f22"><di:waypoint x="1820" y="220" /><di:waypoint x="1870" y="220" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
